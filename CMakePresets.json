{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 18, "patch": 0 },
  "configurePresets": [
    {
      "name": "cpu-release",
      "displayName": "Portable CPU release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BF_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CUDA release (required)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BF_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "CPU sanitizer development build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BF_ENABLE_CUDA": "OFF",
        "BF_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu-release", "configurePreset": "cpu-release" },
    { "name": "cuda-release", "configurePreset": "cuda-release" },
    { "name": "dev", "configurePreset": "dev" }
  ],
  "testPresets": [
    { "name": "cpu-release", "configurePreset": "cpu-release", "output": { "outputOnFailure": true } },
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } }
  ]
}
